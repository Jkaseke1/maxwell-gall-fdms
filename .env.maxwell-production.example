# Maxwell Glass only. Copy to .env.maxwell-production on the company server.
NODE_ENV=production
FDMS_BASE_URL=https://fdmsapi.zimra.co.zw
FDMS_DEVICE_ID=46158
FDMS_DEVICE_SERIAL_NO=ZIMRAVD-1737
FDMS_ACTIVATION_KEY=SET_ON_SERVER_ONLY
FDMS_DEVICE_MODEL_NAME=Server
FDMS_DEVICE_MODEL_VERSION=v1
CUSTOMER_TIN=2000945150
FDMS_CERT_PATH=./certs/maxwell-production/device.cert.pem
FDMS_KEY_PATH=./certs/maxwell-production/device.key.pem

# Persistent application data. Keep this on the server and back it up.
FDMS_DATA_DIR=C:/MaxwellFDMS/data
FDMS_BACKUP_DIR=C:/MaxwellFDMS/backups
FDMS_LOG_DIR=C:/MaxwellFDMS/logs

# Error alerts. Use a Gmail app password or the company's SMTP relay;
# never put the mailbox password in source control.
FDMS_ALERT_TO=kasekejoseph19@gmail.com
FDMS_ALERT_FROM=MAXWELL GLASS FDMS <kasekejoseph19@gmail.com>
FDMS_SMTP_HOST=smtp.gmail.com
FDMS_SMTP_PORT=587
FDMS_SMTP_SECURE=false
FDMS_SMTP_USER=kasekejoseph19@gmail.com
FDMS_SMTP_PASS=SET_ON_SERVER_ONLY
FDMS_ALERT_COOLDOWN_MS=900000
