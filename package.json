{
  "name": "maxwell-glass-fdms",
  "version": "1.0.0",
  "description": "MAXWELL GLASS ZIMRA FDMS invoicing and credit-note system",
  "main": "index.js",
  "scripts": {
    "sandbox:verify": "node scripts/zimraSandbox.js verify",
    "sandbox:register": "node scripts/zimraSandbox.js register",
    "sandbox:status": "node scripts/zimraSandbox.js status",
    "sandbox:api": "node server/sandbox/index.js",
    "sandbox:start": "node scripts/startMaxwellSandbox.js",
    "production:verify": "node scripts/zimraProduction.js verify",
    "production:register": "node scripts/zimraProduction.js register",
    "production:status": "node scripts/zimraProduction.js status",
    "production:start": "node scripts/startMaxwellProduction.js",
    "production:install-service": "node scripts/installMaxwellProductionService.js",
    "test:sandbox": "node scripts/runSandboxTests.cjs",
    "test:preview": "node --test tests/invoicePreview.test.mjs",
    "start": "node index.js",
    "api": "node api-server.js",
    "test": "jest --verbose",
    "test:sig": "jest tests/receiptSignature.test.js --verbose",
    "test-connection": "node scripts/testConnection.js",
    "test-device": "node scripts/testDeviceStatus.js",
    "diagnose": "node scripts/diagnoseDevice.js",
    "setup": "node scripts/setupCertificates.js",
    "test:receipts": "node tests/runAllTests.js",
    "test:invoice": "node tests/testInvoice.js",
    "test:debit-note": "node tests/testDebitNote.js",
    "test:credit-note": "node tests/testCreditNote.js",
    "open-fiscal-day": "node scripts/openFiscalDay.js",
    "close-fiscal-day": "node scripts/closeFiscalDay.js",
    "bridge-api": "node api-server-invoices.js",
    "sage:sync": "node src/integrations/sageConnector.js once",
    "sage:sync:continuous": "node src/integrations/sageConnector.js continuous",
    "fiscalize:once": "node src/integrations/fiscalizationService.js once",
    "fiscalize:continuous": "node src/integrations/fiscalizationService.js continuous",
    "pdf:watch": "node src/integrations/pdfFiscalizationService.js watch",
    "pdf:process": "node src/integrations/pdfFiscalizationService.js once",
    "fdms:setup": "node scripts/setupFDMS.js",
    "reset:client": "node scripts/resetForNewClient.js",
    "reset:client:confirm": "node scripts/resetForNewClient.js --confirm",
    "device:status": "node scripts/checkDeviceStatus.js",
    "system:status": "node scripts/checkSystemStatus.js",
    "device:check": "node scripts/checkDeviceRegistration.js",
    "test:endpoints": "node scripts/testAllEndpoints.js",
    "openday": "node -e \"require('dotenv').config(); const {openFiscalDay} = require('./src/integrations/pdfFiscalizationService'); openFiscalDay().then(r => { console.log('Result:', r); process.exit(0); }).catch(e => { console.error(e.message); process.exit(1); });\"",
    "closeday": "node -e \"require('dotenv').config(); const {closeFiscalDay} = require('./src/integrations/pdfFiscalizationService'); closeFiscalDay().then(r => { console.log('Result:', r); process.exit(0); }).catch(e => { console.error(e.message); process.exit(1); });\"",
    "status": "node -e \"require('dotenv').config(); const {getFiscalDayStatus} = require('./src/integrations/pdfFiscalizationService'); getFiscalDayStatus().then(r => { console.log(JSON.stringify(r, null, 2)); process.exit(0); }).catch(e => { console.error(e.message); process.exit(1); });\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.1",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mssql": "^9.1.1",
    "node-schedule": "^2.1.1",
    "node-windows": "^1.0.0-beta.8",
    "nodemailer": "^7.0.6",
    "odbc": "^2.4.8",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
